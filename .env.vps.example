# Copiar a .env.vps (ignorado por Git). Reemplazar TODAS las claves antes de iniciar.
# PostgreSQL: usar hexadecimal, porque se incorpora a una URL.
COMPOSE_PROJECT_NAME=tallerflow-morichal
HTTP_PORT=18090
BIND_IP=0.0.0.0
POSTGRES_PASSWORD=REEMPLAZAR_POR_HEX_ALEATORIO
ADMIN_EMAIL=admin@tallerflow.local
ADMIN_PASSWORD=REEMPLAZAR_POR_CLAVE_NUEVA_MINIMO_12
SEED_DEMO=false
DEMO_PASSWORD=
# HTTP por IP: false. Para HTTPS configurar el proxy antes de usar true.
COOKIE_SECURE=false
DB_MEMORY_LIMIT=512m
API_MEMORY_LIMIT=1024m
WEB_MEMORY_LIMIT=128m
